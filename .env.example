# AI Singapore (InotGrumpy) Configuration
# ========================================

# Tavily API Key - Required for web search
# Get a free key at: https://app.tavily.com
TAVILY_API_KEY=

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434

# Default SEA-LION model to use
DEFAULT_MODEL=aisingapore/Qwen-SEA-LION-v4-32B-IT

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Application Settings
APP_NAME=InotGrumpy
APP_DESCRIPTION="A patient little LangGraph agent for Southeast Asian languages"

# Shot polling settings (optional)
SHOT_POLL_TIMEOUT=600
SHOT_POLL_INTERVAL=10
ARK_API_KEY=

# Moonshot API Key
MOONSHOT_API_KEY=

# DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=

# SEA-LION API Key
SEALION_API_KEY=
